{
  "version": "1.0",
  "name": "Segfault Studios Enhancement Pack",
  "author": "Segfault Studios",
  "policy": {
    "allowedModules": [
      "basic",
      "string",
      "table",
      "math",
      "io",
      "os"
    ],
    "capabilities": [
      "FileRead",
      "FileWrite",
      "DirectoryOperations"
    ],
    "timeout": 30,
    "memoryLimit": 100,
    "defaultFileAccess": "sandboxedreadwrite",
    "defaultDirectoryAccess": "listandcreatefiles",
    "filePermissions": {
      "/game/assets/**": "read",
      "/game/saves/*.sav": "sandboxedreadwrite",
      "/game/logs/*.log": "readwrite"
    }
  },
  "files": {}
}