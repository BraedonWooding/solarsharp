<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
        <PackageReference Include="KeraLua" Version="1.4.1" />
        <PackageReference Include="LuaCSharp" Version="0.4.2" />
        <PackageReference Include="MoonSharp" Version="2.0.0" />
        <PackageReference Include="NeoLua" Version="1.3.15-beta.4" />
        <PackageReference Include="NLua" Version="1.7.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SolarSharp.Interpreter\SolarSharp.Interpreter.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Tests\*.lua">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Tests\specific_features\*.lua">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
